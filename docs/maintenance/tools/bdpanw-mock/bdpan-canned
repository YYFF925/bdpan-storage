#!/usr/bin/env bash
# Mock that prints the canned payload named by $MOCK_PAYLOAD and nothing else, for verdict tests.
# See bdpan (same directory) for the contract this family of mocks follows.
printf '%s\n' "$*" >> "${MOCK_LOG:-/dev/null}"
case "${1:-}" in login) echo '  --auth-flow <flow>'; exit 0;; esac
cat "$MOCK_PAYLOAD"
